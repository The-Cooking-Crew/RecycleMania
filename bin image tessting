import pygame
import os

pygame.init()

clock = pygame.time.Clock()


BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
RED = (255, 0, 0)
GREEN = (0, 255, 0)
BLUE = (0, 0, 255)

width, height = 800, 600
screen = pygame.display.set_mode((width, height))

#setup assets folder
game_folder = os.path.dirname(__file__)
img_folder = os.path.join(game_folder, "img")

sprites = {
    "Bin closed": pygame.image.load(os.path.join(img_folder, "recyclebin1.jpg")),
    "Bin open": pygame.image.load(os.path.join(img_folder, "recyclebin2.jpg"))
    }
Bin_image = sprites["Bin closed"]



pygame.display.flip()

running = True
while running:
  # Cap the frame rate at 60 FPS
  clock.tick(60)
  for event in pygame.event.get():
    if event.type == pygame.QUIT:
      running = False
  keys = pygame.key.get_pressed()
  if keys[pygame.K_SPACE] == True:
      Bin_image = sprites["Bin open"]
  else:
      Bin_image = sprites["Bin closed"]
          
  pygame.display.flip()
  screen.fill(BLACK)
  screen.blit(Bin_image,(100,100))
  # Event handling





pygame.quit()
